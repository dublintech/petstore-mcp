meta {
  name: 07 resources/templates/list
  type: http
  seq: 7
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json, text/event-stream
  Mcp-Session-Id: {{mcpSession}}
  MCP-Protocol-Version: {{protocolVersion}}
}

body:json {
  { "jsonrpc": "2.0", "id": 7, "method": "resources/templates/list" }
}

tests {
  test("succeeds", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().error).to.be.undefined;
  });
  test("lists the two templates", function() {
    expect(res.getBody().result.resourceTemplates.map(t => t.uriTemplate)).to.have.members(
      ["petstore://pets/{petId}", "petstore://pets/{petId}/card"]);
  });
}

docs {
  The call Claude Desktop never makes, which is why the pet templates are missing from its menu.
}
